{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "运行 Macroquad 地图查看器 (macOS 修复)",
			"type": "shell",
			"command": "./run.sh",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "run test_inventory_dialog",
			"type": "cargo",
			"command": "run",
			"args": [
				"--package",
				"client_macroquad",
				"--bin",
				"test_inventory_dialog"
			],
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "run test_main_dialog",
			"type": "cargo",
			"command": "run",
			"args": [
				"--package",
				"client_macroquad",
				"--bin",
				"test_main_dialog"
			],
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "编译 Release",
			"type": "cargo",
			"command": "build",
			"args": [
				"--release"
			],
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "直接运行 (可能无焦点)",
			"type": "cargo",
			"command": "run",
			"args": [
				"--release"
			],
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build IME Test",
			"type": "shell",
			"command": "cmd /c D:\\Users\\gxh\\Documents\\GitHub\\Crystal\\Client-Macroquad\\build_ime_test.bat"
		}
	]
}