/// KeyCode 映射
pub use macroquad::prelude::KeyCode;

/// MouseButton 映射
pub use macroquad::prelude::MouseButton;

// ============================================================================
// 特殊实体 ID (ECS常量)
// ============================================================================

/// 网络实体 ID
pub const NETWORK_ENTITY: hecs::Entity = unsafe { hecs::Entity::from_bits(u64::MAX) };

/// 设置实体 ID  
pub const SETTING_ENTITY: hecs::Entity = unsafe { hecs::Entity::from_bits(u64::MAX - 1) };

