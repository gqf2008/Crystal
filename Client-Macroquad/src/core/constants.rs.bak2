// ============================================================================
// 游戏常量定义
// ============================================================================

/// 窗口尺寸（实际显示窗口大小）
pub const WINDOW_WIDTH: i32 = 1024;
pub const WINDOW_HEIGHT: i32 = 768;

/// 渲染尺寸 - 内部渲染分辨率，可以不同于窗口尺寸
pub const RENDER_WIDTH: f32 = 1024.0;
pub const RENDER_HEIGHT: f32 = 768.0;

/// 传奇2 瓦片尺寸
pub const TILE_WIDTH: f32 = 48.0;
pub const TILE_HEIGHT: f32 = 32.0;

/// 相机缩放限制
pub const MAX_ZOOM: f32 = 4.0;
pub const MIN_ZOOM: f32 = 0.5;
pub const DEFAULT_ZOOM: f32 = 1.0;

/// 地图渲染配置
pub const MAP_OVERSCAN_BOTTOM: f32 = 200.0; // 底部过扫描区域，避免高建筑物被裁切
