fn parse_magic(payload: &[u8]) -> Result<Magic, String> {
    let mut cursor = Cursor::new(payload);
    let spell_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read magic spell: {err}"))?;
    let spell = Spell::try_from(spell_byte).map_err(|_| format!("unknown spell {spell_byte}"))?;
    let target_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read magic target id: {err}"))?;
    let target = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read magic target: {err}"))?;
    let cast = read_bool(&mut cursor).map_err(|err| format!("failed to read magic cast: {err}"))?;
    let level = cursor
        .read_u8()
        .map_err(|err| format!("failed to read magic level: {err}"))?;

    let count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read magic secondary target count: {err}"))?;
    if count < 0 {
        return Err(format!("negative magic secondary target count {count}"));
    }

    let mut secondary_target_ids = Vec::with_capacity(count as usize);
    for i in 0..count {
        let target_id = cursor
            .read_u32::<LittleEndian>()
            .map_err(|err| format!("failed to read magic secondary target #{i}: {err}"))?;
        secondary_target_ids.push(target_id);
    }

    Ok(Magic {
        spell,
        target_id,
        target,
        cast,
        level,
        secondary_target_ids,
    })
}

