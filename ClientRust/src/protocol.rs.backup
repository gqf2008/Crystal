fn parse_guild_storage_item_change(payload: &[u8]) -> Result<GuildStorageItemChange, String> {
    let mut cursor = Cursor::new(payload);
    let change_type = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild storage item type: {err}"))?;
    let to = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild storage item to: {err}"))?;
    let from = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild storage item from: {err}"))?;
    let user = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild storage item user: {err}"))?;
    let has_item = read_bool(&mut cursor)
        .map_err(|err| format!("failed to read guild storage item flag: {err}"))?;

    let (user_id, item) = if has_item {
        let uid = cursor
            .read_i64::<LittleEndian>()
            .map_err(|err| format!("failed to read guild storage item user id: {err}"))?;
        let it = UserItem::read_default(&mut cursor)
            .map_err(|err| format!("failed to read guild storage item: {err}"))?;
        (Some(uid), Some(it))
    } else {
        (None, None)
    };

    Ok(GuildStorageItemChange {
        change_type,
        to,
        from,
        user,
        user_id,
        item,
    })
}

fn parse_new_hero(payload: &[u8]) -> Result<NewHero, String> {
    let mut cursor = Cursor::new(payload);
    let result = cursor
        .read_u8()
        .map_err(|err| format!("failed to read new hero result: {err}"))?;
    Ok(NewHero { result })
}

fn parse_hero_information(payload: &[u8]) -> Result<HeroInformation, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero object id: {err}"))?;
    let name = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read hero name: {err}"))?;
    let class_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read hero class: {err}"))?;
    let class =
        MirClass::try_from(class_byte).map_err(|_| format!("unknown hero class {class_byte}"))?;
    let gender_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read hero gender: {err}"))?;
    let gender = MirGender::try_from(gender_byte)
        .map_err(|_| format!("unknown hero gender {gender_byte}"))?;
    let level = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read hero level: {err}"))?;
    let hair = cursor
        .read_u8()
        .map_err(|err| format!("failed to read hero hair: {err}"))?;
    let hp = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero hp: {err}"))?;
    let mp = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero mp: {err}"))?;
    let experience = cursor
        .read_i64::<LittleEndian>()
        .map_err(|err| format!("failed to read hero experience: {err}"))?;
    let max_experience = cursor
        .read_i64::<LittleEndian>()
        .map_err(|err| format!("failed to read hero max experience: {err}"))?;

    let inventory = read_item_slots(&mut cursor)?;
    let equipment = read_item_slots(&mut cursor)?;

    let magic_count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero magic count: {err}"))?;
    let mut magics = Vec::with_capacity(magic_count as usize);
    for _ in 0..magic_count {
        let magic = ClientMagic::read_from(&mut cursor)
            .map_err(|err| format!("failed to read hero magic: {err}"))?;
        magics.push(magic);
    }

    let auto_pot =
        read_bool(&mut cursor).map_err(|err| format!("failed to read hero auto pot: {err}"))?;
    let auto_hp_percent = cursor
        .read_u8()
        .map_err(|err| format!("failed to read hero auto hp percent: {err}"))?;
    let auto_mp_percent = cursor
        .read_u8()
        .map_err(|err| format!("failed to read hero auto mp percent: {err}"))?;
    let hp_item_index = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero hp item index: {err}"))?;
    let mp_item_index = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read hero mp item index: {err}"))?;

    Ok(HeroInformation {
        object_id,
        name,
        class,
        gender,
        level,
        hair,
        hp,
        mp,
        experience,
        max_experience,
        inventory,
        equipment,
        magics,
        auto_pot,
        auto_hp_percent,
        auto_mp_percent,
        hp_item_index,
        mp_item_index,
    })
}

fn parse_map_changed(payload: &[u8]) -> Result<MapChanged, String> {
    let mut cursor = Cursor::new(payload);
    let map_index = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read map index: {err}"))?;
    let file_name = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read map file name: {err}"))?;
    let title = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read map title: {err}"))?;
    let mini_map = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read map mini map: {err}"))?;
    let big_map = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read map big map: {err}"))?;
    let lights = cursor
        .read_u8()
        .map_err(|err| format!("failed to read map lights: {err}"))?;
    let location = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read map location: {err}"))?;
    let direction_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read map direction: {err}"))?;
    let direction = MirDirection::try_from(direction_byte)
        .map_err(|_| format!("unknown map direction {direction_byte}"))?;
    let map_dark_light = cursor
        .read_u8()
        .map_err(|err| format!("failed to read map dark light: {err}"))?;
    let music = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read map music: {err}"))?;
    let weather_value = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read map weather: {err}"))?;
    let weather = unsafe { std::mem::transmute::<u16, WeatherSetting>(weather_value) };

    Ok(MapChanged {
        map_index,
        file_name,
        title,
        mini_map,
        big_map,
        lights,
        location,
        direction,
        map_dark_light,
        music,
        weather,
    })
}

