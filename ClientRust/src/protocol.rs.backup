fn parse_object_range_attack(payload: &[u8]) -> Result<ObjectRangeAttack, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object range attack id: {err}"))?;
    let location = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read object range attack location: {err}"))?;
    let direction_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object range attack direction: {err}"))?;
    let direction = MirDirection::try_from(direction_byte)
        .map_err(|_| format!("unknown object range attack direction {direction_byte}"))?;
    let target_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object range attack target id: {err}"))?;
    let target = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read object range attack target: {err}"))?;
    let attack_type = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object range attack type: {err}"))?;
    let spell_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object range attack spell: {err}"))?;
    let spell = Spell::try_from(spell_byte)
        .map_err(|_| format!("unknown object range attack spell {spell_byte}"))?;
    let level = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object range attack level: {err}"))?;

    Ok(ObjectRangeAttack {
        object_id,
        location,
        direction,
        target_id,
        target,
        attack_type,
        spell,
        level,
    })
}

