    let mut cursor = Cursor::new(payload);
    let count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read complete quest count: {err}"))?;

    let mut completed_quests = Vec::with_capacity(count as usize);
    for _ in 0..count {
        let quest_id = cursor
            .read_i32::<LittleEndian>()
            .map_err(|err| format!("failed to read completed quest id: {err}"))?;
        completed_quests.push(quest_id);
