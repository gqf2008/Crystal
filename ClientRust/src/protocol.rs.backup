        },
        Ok(ServerPacketId::UserSlotsRefresh) => match packets::player::parse_user_slots_refresh(&payload) {
            Ok(info) => ServerMessage::UserSlotsRefresh(info),
            Err(message) => ServerMessage::ParseError {
                opcode: header.opcode,
