fn parse_object_magic(payload: &[u8]) -> Result<ObjectMagic, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object magic object id: {err}"))?;
    let location = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read object magic location: {err}"))?;
    let direction_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object magic direction: {err}"))?;
    let direction = MirDirection::try_from(direction_byte)
        .map_err(|_| format!("unknown object magic direction {direction_byte}"))?;

    let spell_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object magic spell: {err}"))?;
    let spell = Spell::try_from(spell_byte)
        .map_err(|_| format!("unknown object magic spell {spell_byte}"))?;
    let target_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object magic target id: {err}"))?;

    let target = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read object magic target: {err}"))?;
    let cast =
        read_bool(&mut cursor).map_err(|err| format!("failed to read object magic cast: {err}"))?;
    let level = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object magic level: {err}"))?;
    let self_broadcast = read_bool(&mut cursor)
        .map_err(|err| format!("failed to read object magic self broadcast: {err}"))?;

    let count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read object magic secondary target count: {err}"))?;
    if count < 0 {
        return Err(format!(
            "negative object magic secondary target count {count}"
        ));
    }

    let mut secondary_target_ids = Vec::with_capacity(count as usize);
    for i in 0..count {
        let target_id = cursor
            .read_u32::<LittleEndian>()
            .map_err(|err| format!("failed to read object magic secondary target #{i}: {err}"))?;
        secondary_target_ids.push(target_id);
    }

    Ok(ObjectMagic {
        object_id,
        location,
        direction,
        spell,
        target_id,
        target,
        cast,
        level,
        self_broadcast,
        secondary_target_ids,
    })
}

fn parse_object_effect(payload: &[u8]) -> Result<ObjectEffect, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
