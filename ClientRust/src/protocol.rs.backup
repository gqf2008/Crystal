fn parse_guild_status(payload: &[u8]) -> Result<GuildStatus, String> {
    let mut cursor = Cursor::new(payload);
    let guild_name = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read guild name: {err}"))?;
    let guild_rank_name = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read guild rank name: {err}"))?;
    let level = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild level: {err}"))?;
    let experience = cursor
        .read_i64::<LittleEndian>()
        .map_err(|err| format!("failed to read guild experience: {err}"))?;
    let max_experience = cursor
        .read_i64::<LittleEndian>()
        .map_err(|err| format!("failed to read guild max experience: {err}"))?;
    let gold = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild gold: {err}"))?;
    let spare_points = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild spare points: {err}"))?;
    let member_count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild member count: {err}"))?;
    let max_members = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild max members: {err}"))?;
    let voting =
        read_bool(&mut cursor).map_err(|err| format!("failed to read guild voting: {err}"))?;
    let item_count = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild item count: {err}"))?;
    let buff_count = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild buff count: {err}"))?;
    let my_options = cursor
        .read_u8()
        .map_err(|err| format!("failed to read guild my options: {err}"))?;
    let my_rank_id = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read guild my rank id: {err}"))?;

    Ok(GuildStatus {
        guild_name,
        guild_rank_name,
        level,
        experience,
        max_experience,
        gold,
        spare_points,
        member_count,
        max_members,
        voting,
        item_count,
        buff_count,
        my_options,
        my_rank_id,
    })
}

