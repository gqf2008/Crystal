    CompleteQuest(CompleteQuest),
    NPCGoods(NPCGoods),
    ObjectHide(ObjectHide),
    ObjectShow(ObjectShow),
    Poisoned(Poisoned),
    ObjectPoisoned(ObjectPoisoned),
    Revived(Revived),
