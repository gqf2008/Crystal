    let effect_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object effect: {err}"))?;
    let effect = SpellEffect::try_from(effect_byte)
        .map_err(|_| format!("unknown object effect {effect_byte}"))?;
    let effect_type = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object effect type: {err}"))?;
    let delay_time = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object effect delay time: {err}"))?;
    let time = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object effect time: {err}"))?;

    Ok(ObjectEffect {
        object_id,
        effect,
        effect_type,
        delay_time,
        time,
    })
}

fn parse_object_projectile(payload: &[u8]) -> Result<ObjectProjectile, String> {
    let mut cursor = Cursor::new(payload);
    let spell_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read object projectile spell: {err}"))?;
    let spell = Spell::try_from(spell_byte)
        .map_err(|_| format!("unknown object projectile spell {spell_byte}"))?;
    let source = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object projectile source: {err}"))?;
    let destination = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read object projectile destination: {err}"))?;

    Ok(ObjectProjectile {
        spell,
        source,
        destination,
    })
}

