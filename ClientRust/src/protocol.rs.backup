fn parse_npc_goods(payload: &[u8]) -> Result<NPCGoods, String> {
    let mut cursor = Cursor::new(payload);
    let count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc goods count: {err}"))?;

    let mut list = Vec::with_capacity(count as usize);
    for _ in 0..count {
        let item = UserItem::read_default(&mut cursor)
            .map_err(|err| format!("failed to read npc good item: {err}"))?;
        list.push(item);
    }

    let rate = cursor
        .read_f32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc goods rate: {err}"))?;
    let panel_type = cursor
        .read_u8()
        .map_err(|err| format!("failed to read npc goods panel type: {err}"))?;
    let hide_added_stats = read_bool(&mut cursor)
        .map_err(|err| format!("failed to read npc goods hide added stats: {err}"))?;

    Ok(NPCGoods {
        list,
        rate,
        panel_type,
        hide_added_stats,
    })
}

