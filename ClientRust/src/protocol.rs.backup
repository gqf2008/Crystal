fn parse_object_monster(payload: &[u8]) -> Result<ObjectMonster, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read monster object id: {err}"))?;
    let name = read_dotnet_string(&mut cursor)
        .map_err(|err| format!("failed to read monster name: {err}"))?;
    let name_colour_argb = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read monster name colour: {err}"))?;
    let location = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read monster location: {err}"))?;
    let image = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read monster image: {err}"))?;
    let direction_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read monster direction: {err}"))?;
    let direction = MirDirection::try_from(direction_byte)
        .map_err(|_| format!("unknown monster direction {direction_byte}"))?;
    let effect = cursor
        .read_u8()
        .map_err(|err| format!("failed to read monster effect: {err}"))?;
    let ai = cursor
        .read_u8()
        .map_err(|err| format!("failed to read monster ai: {err}"))?;
    let light = cursor
        .read_u8()
        .map_err(|err| format!("failed to read monster light: {err}"))?;
    let dead =
        read_bool(&mut cursor).map_err(|err| format!("failed to read monster dead: {err}"))?;
    let skeleton =
        read_bool(&mut cursor).map_err(|err| format!("failed to read monster skeleton: {err}"))?;
    let poison_bits = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read monster poison: {err}"))?;
    let poison = PoisonType::from_bits(poison_bits)
        .ok_or_else(|| format!("unknown monster poison flags {poison_bits:#06x}"))?;
    let hidden =
        read_bool(&mut cursor).map_err(|err| format!("failed to read monster hidden: {err}"))?;
    let shock_time = cursor
        .read_i64::<LittleEndian>()
        .map_err(|err| format!("failed to read monster shock time: {err}"))?;
    let binding_shot_center = read_bool(&mut cursor)
        .map_err(|err| format!("failed to read monster binding shot center: {err}"))?;
    let extra =
        read_bool(&mut cursor).map_err(|err| format!("failed to read monster extra: {err}"))?;
    let extra_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read monster extra byte: {err}"))?;

    let buff_count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read monster buff count: {err}"))?;
    if buff_count < 0 {
        return Err(format!("negative monster buff count {buff_count}"));
    }

    let mut buffs = Vec::with_capacity(buff_count as usize);
    for index in 0..buff_count {
        let buff_byte = cursor
            .read_u8()
            .map_err(|err| format!("failed to read monster buff #{index}: {err}"))?;
        let buff_type = BuffType::try_from(buff_byte)
            .map_err(|_| format!("unknown monster buff type {buff_byte} at index {index}"))?;
        buffs.push(buff_type);
    }

    Ok(ObjectMonster {
        object_id,
        name,
        name_colour_argb,
        location,
        image,
        direction,
        effect,
        ai,
        light,
        dead,
        skeleton,
        poison,
        hidden,
        shock_time,
        binding_shot_center,
        extra,
        extra_byte,
        buffs,
    })
}

fn parse_object_npc(payload: &[u8]) -> Result<ObjectNpc, String> {
    let mut cursor = Cursor::new(payload);
    let object_id = cursor
        .read_u32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc object id: {err}"))?;
    let name =
        read_dotnet_string(&mut cursor).map_err(|err| format!("failed to read npc name: {err}"))?;
    let name_colour_argb = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc name colour: {err}"))?;
    let image = cursor
        .read_u16::<LittleEndian>()
        .map_err(|err| format!("failed to read npc image: {err}"))?;
    let colour_argb = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc colour: {err}"))?;
    let location = Point::read_from(&mut cursor)
        .map_err(|err| format!("failed to read npc location: {err}"))?;
    let direction_byte = cursor
        .read_u8()
        .map_err(|err| format!("failed to read npc direction: {err}"))?;
    let direction = MirDirection::try_from(direction_byte)
        .map_err(|_| format!("unknown npc direction {direction_byte}"))?;

    let quest_count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc quest count: {err}"))?;
    if quest_count < 0 {
        return Err(format!("negative npc quest count {quest_count}"));
    }

    let mut quest_ids = Vec::with_capacity(quest_count as usize);
    for index in 0..quest_count {
        let quest_id = cursor
            .read_i32::<LittleEndian>()
            .map_err(|err| format!("failed to read npc quest id #{index}: {err}"))?;
        quest_ids.push(quest_id);
    }

    Ok(ObjectNpc {
        object_id,
        name,
        name_colour_argb,
        image,
        colour_argb,
        location,
        direction,
        quest_ids,
    })
}

fn parse_npc_response(payload: &[u8]) -> Result<NpcResponse, String> {
    let mut cursor = Cursor::new(payload);
    let count = cursor
        .read_i32::<LittleEndian>()
        .map_err(|err| format!("failed to read npc response count: {err}"))?;
    if count < 0 {
        return Err(format!("negative npc response count {count}"));
    }

    let mut page = Vec::with_capacity(count as usize);
    for index in 0..count {
        let line = read_dotnet_string(&mut cursor)
            .map_err(|err| format!("failed to read npc response line #{index}: {err}"))?;
        page.push(line);
    }

    Ok(NpcResponse { page })
}

