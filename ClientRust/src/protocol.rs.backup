    DropItem(DropItem),
    Pushed(Pushed),
    ObjectPushed(ObjectPushed),
    AddBuff(AddBuff),
    RemoveBuff(RemoveBuff),
    PauseBuff(PauseBuff),
    TradeRequest(TradeRequest),
    TradeAccept(TradeAccept),
    TradeGold(TradeGold),
    TradeItem(TradeItem),
    TradeConfirm(TradeConfirm),
    TradeCancel(TradeCancel),
    GroupInvite(GroupInvite),
    AddMember(AddMember),
    DeleteGroup(DeleteGroup),
