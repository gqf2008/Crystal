// ============================================================================
// 辅助函数
// ============================================================================

use anyhow::Result;
use byteorder::{LittleEndian, WriteBytesExt};
use std::io::Write;

/// 序列化客户端数据包为字节流
///
/// 这个函数会:
/// 1. 添加2字节长度头
/// 2. 添加2字节opcode
/// 3. 序列化数据包体
/// 4. 回填正确的长度
///
/// # 示例
/// ```ignore
/// use mir2_shared::packets::client::connection::ClientVersion;
/// 
/// let packet = ClientVersion { version_hash: 12345 };
/// let bytes = serialize_client_packet(&packet)?;
/// // 现在bytes可以发送到网络
/// ```
pub fn serialize_client_packet<P: Packet>(packet: &P) -> Result<Vec<u8>> {
    let mut buffer = Vec::new();
    
    // 1. 写入长度占位符 (2字节)
    buffer.extend_from_slice(&[0u8, 0u8]);
    
    // 2. 写入opcode (2字节)
    buffer.write_i16::<LittleEndian>(P::OPCODE)?;
    
    // 3. 写入数据包体
    packet.write_body(&mut buffer)?;
    
    // 4. 回填实际长度
    let length = buffer.len() as u16;
    LittleEndian::write_u16(&mut buffer[0..2], length);
    
    Ok(buffer)
}

/// 从字节流解析服务器数据包
///
/// 注意: SharedRust中每个服务器数据包都实现了Packet trait,
/// 可以直接调用 `PacketType::read_body(&mut cursor)` 来反序列化
///
/// # 示例
/// ```ignore
/// use mir2_shared::packets::server::connection::Connected;
/// use std::io::Cursor;
/// 
/// let data: Vec<u8> = receive_from_network();
/// let mut cursor = Cursor::new(&data[4..]); // 跳过长度和opcode
/// let packet = Connected::read_body(&mut cursor)?;
/// ```
pub fn parse_server_packet_header(data: &[u8]) -> Result<(u16, i16)> {
    if data.len() < 4 {
        anyhow::bail!("数据包太短: {} 字节", data.len());
    }
    
    let length = LittleEndian::read_u16(&data[0..2]);
    let opcode = LittleEndian::read_i16(&data[2..4]);
    
    Ok((length, opcode))
}
