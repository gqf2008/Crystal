use std::path::{Path, PathBuf};
use byteorder::{LittleEndian, ReadBytesExt};
use super::map_control::MapControl;

#[derive(Debug)]
pub enum MapLoadError {
    IoError(std::io::Error),
    InvalidFormat(String),
    UnsupportedVersion(u8),
}

impl std::fmt::Display for MapLoadError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            MapLoadError::IoError(e) => write!(f, "IO error: {}", e),
            MapLoadError::InvalidFormat(s) => write!(f, "Invalid map format: {}", s),
            MapLoadError::UnsupportedVersion(v) => write!(f, "Unsupported map version: {}", v),
        }
    }
}

impl std::error::Error for MapLoadError {}

impl From<std::io::Error> for MapLoadError {
    fn from(err: std::io::Error) -> Self {
        MapLoadError::IoError(err)
    }
}

/// Map type detection result
#[derive(Debug)]
enum MapType {
    Type0,  // Old format
    Type1,  // Map 2010 Ver 1.0 (encrypted with XOR)
    Type2,  // Shanda format (14 bytes per cell)
    Type100, // C# custom format (no encryption, 26 bytes per cell)
}

/// Detect map type from header bytes
fn detect_map_type(bytes: &[u8]) -> MapType {
    if bytes.len() < 20 {
        return MapType::Type0;
    }
    
    // Type100: C# custom format
    // Bytes[2] == 0x43 && Bytes[3] == 0x23 (ASCII "C#")
    if bytes.len() >= 4 && bytes[2] == 0x43 && bytes[3] == 0x23 {
        tracing::info!("🗺️  Detected Type100 map (C# custom format)");
        return MapType::Type100;
    }
    
    // Type1: Map 2010 Ver 1.0
    // Bytes[0] == 0x10 && Bytes[2] == 0x61 && Bytes[7] == 0x31 && Bytes[14] == 0x31
    if bytes[0] == 0x10 && bytes[2] == 0x61 && bytes[7] == 0x31 && bytes[14] == 0x31 {
        tracing::info!("🗺️  Detected Type1 map (Map 2010 Ver 1.0)");
        return MapType::Type1;
    }
    
    // Type2: Shanda format (check bytes[4] and bytes[18..20])
    if bytes.len() >= 20 && (bytes[4] == 0x0F || bytes[4] == 0x03) && bytes[18] == 0x0D && bytes[19] == 0x0A {
        tracing::info!("🗺️  Detected Type2 map (Shanda format)");
        return MapType::Type2;
    }
    
    // Default: Type0
    tracing::info!("🗺️  Detected Type0 map (default format)");
    MapType::Type0
}

/// Load map from .map file
/// 
/// Supports multiple map formats:
/// - Type0: Old format (12 bytes per cell)
/// - Type1: Map 2010 Ver 1.0 (14 bytes per cell, encrypted with XOR)
/// - Type2: Shanda format (14 bytes per cell)
pub fn load_map<P: AsRef<Path>>(path: P) -> Result<MapControl, MapLoadError> {
    let path = path.as_ref();
    tracing::info!("📂 Loading map file: {}", path.display());
    
    // Read entire file
    let bytes = std::fs::read(path)?;
    tracing::debug!("📄 File read successfully: {} bytes", bytes.len());
    
    if bytes.len() < 54 {
        return Err(MapLoadError::InvalidFormat(format!("File too small: {} bytes", bytes.len())));
    }
    
    // Detect map type
    tracing::debug!("🔍 Detecting map type...");
    let map_type = detect_map_type(&bytes);
    tracing::debug!("🔍 Map type detected: {:?}", map_type);
    
    // Load according to type
    match map_type {
        MapType::Type100 => load_map_type100(&bytes),
        MapType::Type1 => load_map_type1(&bytes),
        MapType::Type2 => load_map_type2(&bytes),
        MapType::Type0 => load_map_type0(&bytes),
    }
}

/// Load Type1 map (Map 2010 Ver 1.0)
/// 
/// Format:
/// - Offset 0-20: Header ("Map 2010 Ver 1.0" + padding)
/// - Offset 21: Width (2 bytes)
/// - Offset 23: XOR key (2 bytes)
/// - Offset 25: Height (2 bytes)
/// - Offset 54+: Cell data (14 bytes per cell)
///   - BackImage (4 bytes, XOR 0xAA38AA38)
///   - MiddleImage (2 bytes, XOR xor)
///   - FrontImage (2 bytes, XOR xor)
///   - DoorIndex (1 byte)
///   - DoorOffset (1 byte)
///   - FrontAnimationFrame (1 byte)
///   - FrontAnimationTick (1 byte)
///   - FrontIndex (1 byte)
///   - Light (1 byte)
///   - Unknown (1 byte)
fn load_map_type1(bytes: &[u8]) -> Result<MapControl, MapLoadError> {
    tracing::debug!("🔧 Loading Type1 map (Map 2010 Ver 1.0)...");
    let mut offset = 21;
    
    // Read width/height with XOR decryption
    let w = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
    offset += 2;
    let xor = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
    offset += 2;
    let h = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
    
    let width = (w ^ xor) as i32;
    let height = (h ^ xor) as i32;
    tracing::debug!("🔧 Decoded dimensions: {}x{} (w={}, h={}, xor=0x{:04X})", width, height, w, h, xor);
    
    tracing::info!("📊 Map size: {}x{} (xor key: 0x{:04X})", width, height, xor);
    
    // Validate dimensions
    if width <= 0 || height <= 0 || width > 10000 || height > 10000 {
        return Err(MapLoadError::InvalidFormat(format!("Invalid dimensions: {}x{}", width, height)));
    }
    
    // Create map
    let mut map = MapControl::new(width, height);
    
    // Skip to offset 54 (cell data starts here)
    offset = 54;
    
    let expected_size = 54 + (width * height * 14) as usize;
    if bytes.len() < expected_size {
        tracing::warn!("⚠️ File smaller than expected: {} < {}", bytes.len(), expected_size);
    }
    
    // Read cells (14 bytes per cell)
    let mut cells_read = 0;
    for x in 0..width {
        for y in 0..height {
            if offset + 14 > bytes.len() {
                tracing::warn!("⚠️ Unexpected EOF at cell ({}, {})", x, y);
                break;
            }
            
            // BackImage (4 bytes, XOR 0xAA38AA38) - Ground layer
            let back_image_raw = i32::from_le_bytes([
                bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]
            ]);
            let back_image = back_image_raw ^ (0xAA38AA38u32 as i32);
            offset += 4;
            
            // MiddleImage (2 bytes, XOR xor) - Middle decoration layer
            let middle_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) ^ xor;
            offset += 2;
            
            // FrontImage (2 bytes, XOR xor) - Front objects layer (buildings, trees)
            let front_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) ^ xor;
            offset += 2;
            
            // DoorIndex (1 byte) - 0x00 means walkable
            let door_index = bytes[offset] & 0x7F;
            offset += 1;
            
            // DoorOffset (1 byte)
            let door_offset = bytes[offset];
            offset += 1;
            
            // FrontAnimationFrame (1 byte)
            let front_anim_frame = bytes[offset];
            offset += 1;
            
            // FrontAnimationTick (1 byte)
            let front_anim_tick = bytes[offset];
            offset += 1;
            
            // FrontIndex (1 byte + 2) - Library index for front layer
            let mut front_index = bytes[offset] as i32 + 2;
            offset += 1;
            
            // Light (1 byte)
            let light = bytes[offset];
            offset += 1;
            
            // Unknown (1 byte)
            let _unknown = bytes[offset];
            offset += 1;
            
            // Special handling for FrontIndex (from C# code)
            if front_index == 102 {
                front_index = 90;
            }
            if front_index >= 255 {
                front_index = -1;
            }
            
            // Set cell data with all 3 layers
            if let Some(cell) = map.get_cell_mut(x, y) {
                // Back layer (ground) - BackIndex is always 0 in Type1
                cell.back_image = back_image & 0x1FFFFFFF; // Mask out extra bits like C# does
                cell.back_index = 0;
                
                // Middle layer (decorations)
                cell.middle_image = middle_image;
                cell.middle_index = 1; // MiddleIndex is 1 in Type1
                
                // Front layer (buildings, trees)
                cell.front_image = front_image & 0x7FFF; // Mask like C# does
                cell.front_index = front_index;
                cell.front_anim_frame = front_anim_frame;
                cell.front_anim_tick = front_anim_tick;
                cell.door_offset = door_offset;
                
                // Legacy fields (for compatibility)
                cell.file_index = 0;
                cell.frame_index = if back_image >= 0 { back_image as u16 } else { 0 };
                
                // Walkability: door_index == 0 means walkable
                cell.walkable = door_index == 0;
                cell.door_index = if door_index > 0 { Some(door_index as usize) } else { None };
                
                // Fishable: light 100-119 means fishing
                cell.fishable = light >= 100 && light <= 119;
                cell.light_intensity = light;
                
                cells_read += 1;
            }
        }
    }
    
    tracing::info!("✅ Type1 map loaded: {}x{} cells ({} read)", width, height, cells_read);
    Ok(map)
}

/// Load Type2 map (Shanda format)
/// 
/// Format:
/// - Offset 0-1: Width (2 bytes)
/// - Offset 2-3: Height (2 bytes)
/// - Offset 52+: Cell data (14 bytes per cell)
fn load_map_type2(bytes: &[u8]) -> Result<MapControl, MapLoadError> {
    let width = i16::from_le_bytes([bytes[0], bytes[1]]) as i32;
    let height = i16::from_le_bytes([bytes[2], bytes[3]]) as i32;
    
    tracing::info!("📊 Type2 map size: {}x{}", width, height);
    
    if width <= 0 || height <= 0 || width > 10000 || height > 10000 {
        return Err(MapLoadError::InvalidFormat(format!("Invalid dimensions: {}x{}", width, height)));
    }
    
    let mut map = MapControl::new(width, height);
    let mut offset = 52;
    
    // Read cells (14 bytes per cell)
    for x in 0..width {
        for y in 0..height {
            if offset + 14 > bytes.len() {
                break;
            }
            
            // BackImage (2 bytes)
            let back_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
            offset += 2;
            
            // MiddleImage (2 bytes)
            let _middle_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
            offset += 2;
            
            // Skip remaining 10 bytes
            offset += 10;
            
            if let Some(cell) = map.get_cell_mut(x, y) {
                cell.file_index = 0;
                cell.frame_index = if back_image >= 0 { back_image as u16 } else { 0 };
                cell.walkable = true; // Assume walkable by default
            }
        }
    }
    
    tracing::info!("✅ Type2 map loaded: {}x{} cells", width, height);
    Ok(map)
}

/// Load Type0 map (old default format)
/// 
/// Format:
/// - Offset 0-1: Width (2 bytes)
/// - Offset 2-3: Height (2 bytes)
/// - Offset 52+: Cell data (12 bytes per cell)
fn load_map_type0(bytes: &[u8]) -> Result<MapControl, MapLoadError> {
    let width = i16::from_le_bytes([bytes[0], bytes[1]]) as i32;
    let height = i16::from_le_bytes([bytes[2], bytes[3]]) as i32;
    
    tracing::info!("📊 Type0 map size: {}x{}", width, height);
    
    if width <= 0 || height <= 0 || width > 10000 || height > 10000 {
        return Err(MapLoadError::InvalidFormat(format!("Invalid dimensions: {}x{}", width, height)));
    }
    
    let mut map = MapControl::new(width, height);
    let mut offset = 52;
    
    // Read cells (12 bytes per cell)
    for x in 0..width {
        for y in 0..height {
            if offset + 12 > bytes.len() {
                break;
            }
            
            // BackImage (2 bytes)
            let back_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
            offset += 2;
            
            // MiddleImage (2 bytes)
            let _middle_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
            offset += 2;
            
            // Skip remaining 8 bytes
            offset += 8;
            
            if let Some(cell) = map.get_cell_mut(x, y) {
                cell.file_index = 0;
                cell.frame_index = if back_image >= 0 { back_image as u16 } else { 0 };
                cell.walkable = true; // Assume walkable by default
            }
        }
    }
    
    tracing::info!("✅ Type0 map loaded: {}x{} cells", width, height);
    Ok(map)
}

/// Search for map file in standard locations
fn find_map_file(map_name: &str) -> Option<PathBuf> {
    // Strip .map extension if present
    let map_name = map_name.trim_end_matches(".map");
    
    // Search paths (in order of priority)
    let search_paths = [
        format!("Data/Map/{}.map", map_name),
        format!("Data/Map/WemadeMir2/{}.map", map_name),
        format!("Data/Map/ShandaMir2/{}.map", map_name),
        format!("Map/{}.map", map_name), // Fallback
    ];
    
    for path in &search_paths {
        let path = PathBuf::from(path);
        if path.exists() {
            tracing::debug!("✅ Found map file: {:?}", path);
            return Some(path);
        }
    }
    
    tracing::warn!("⚠️ Map file not found: {}", map_name);
    None
}

/// Load Type100 map (C# custom format)
///
/// Format:
/// - Offset 0-1: Version (0x0001)
/// - Offset 2-3: Signature (0x4323 = "C#")
/// - Offset 4-5: Width (2 bytes)
/// - Offset 6-7: Height (2 bytes)
/// - Offset 8+: Cell data (26 bytes per cell, NO XOR encryption)
///   - BackIndex (2 bytes)
///   - BackImage (4 bytes)
///   - MiddleIndex (2 bytes)
///   - MiddleImage (2 bytes)
///   - FrontIndex (2 bytes)
///   - FrontImage (2 bytes)
///   - DoorIndex (1 byte)
///   - DoorOffset (1 byte)
///   - FrontAnimationFrame (1 byte)
///   - FrontAnimationTick (1 byte)
///   - MiddleAnimationFrame (1 byte)
///   - MiddleAnimationTick (1 byte)
///   - TileAnimationImage (2 bytes)
///   - TileAnimationOffset (2 bytes)
///   - TileAnimationFrames (1 byte)
///   - Light (1 byte)
fn load_map_type100(bytes: &[u8]) -> Result<MapControl, MapLoadError> {
    tracing::info!("🗺️  Loading Type100 map (C# custom format)...");
    
    // Check version
    if bytes.len() < 8 || bytes[0] != 1 || bytes[1] != 0 {
        return Err(MapLoadError::UnsupportedVersion(bytes[0]));
    }
    
    let mut offset = 4;
    
    // Read dimensions
    let width = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
    offset += 2;
    let height = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
    offset += 2;
    
    tracing::info!("📏 Map dimensions: {}x{}", width, height);
    
    // Create map control
    let mut map = MapControl::new(width, height);
    
    // Expected size check (26 bytes per cell)
    let expected_size = 8 + (width * height * 26) as usize;
    if bytes.len() < expected_size {
        tracing::warn!("⚠️ File smaller than expected: {} < {}", bytes.len(), expected_size);
    }
    
    // Read cells (26 bytes per cell, NO XOR)
    let mut cells_read = 0;
    for x in 0..width {
        for y in 0..height {
            if offset + 26 > bytes.len() {
                tracing::warn!("⚠️ Unexpected EOF at cell ({}, {})", x, y);
                break;
            }
            
            // BackIndex (2 bytes)
            let back_index = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // BackImage (4 bytes)
            let back_image = i32::from_le_bytes([
                bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]
            ]);
            offset += 4;
            
            // MiddleIndex (2 bytes)
            let middle_index = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // MiddleImage (2 bytes)
            let middle_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // FrontIndex (2 bytes)
            let front_index = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // FrontImage (2 bytes)
            let front_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // DoorIndex (1 byte)
            let door_index = bytes[offset] & 0x7F;
            offset += 1;
            
            // DoorOffset (1 byte)
            let door_offset = bytes[offset];
            offset += 1;
            
            // FrontAnimationFrame (1 byte)
            let front_anim_frame = bytes[offset];
            offset += 1;
            
            // FrontAnimationTick (1 byte)
            let front_anim_tick = bytes[offset];
            offset += 1;
            
            // MiddleAnimationFrame (1 byte)
            let middle_anim_frame = bytes[offset];
            offset += 1;
            
            // MiddleAnimationTick (1 byte)
            let middle_anim_tick = bytes[offset];
            offset += 1;
            
            // TileAnimationImage (2 bytes)
            let tile_anim_image = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // TileAnimationOffset (2 bytes)
            let tile_anim_offset = i16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as i32;
            offset += 2;
            
            // TileAnimationFrames (1 byte)
            let tile_anim_frames = bytes[offset];
            offset += 1;
            
            // Light (1 byte)
            let light = bytes[offset];
            offset += 1;
            
            // Store in map (no transformation needed)
            if let Some(cell) = map.get_cell_mut(x, y) {
                cell.back_image = back_image;
                cell.back_index = back_index;
                cell.middle_image = middle_image as i16;  // Keep as i16
                cell.middle_index = middle_index;
                cell.front_image = front_image as i16;  // Keep as i16
                cell.front_index = front_index;
                
                if door_index > 0 {
                    cell.door_index = Some(door_index as usize);  // Convert to usize
                    cell.door_offset = door_offset;
                }
                
                // Note: animation fields not yet in CellInfo struct
                // TODO: Add these fields if needed for animations
                
                cells_read += 1;
            }
        }
    }
    
    tracing::info!("✅ Map loaded successfully: {} cells read", cells_read);
    
    Ok(map)
}

/// Load map by name (searches standard locations)
pub fn load_map_by_name(map_name: &str) -> Result<MapControl, MapLoadError> {
    if let Some(path) = find_map_file(map_name) {
        let mut map = load_map(path)?;
        map.filename = map_name.to_string();
        map.title = map_name.to_string();
        Ok(map)
    } else {
        Err(MapLoadError::InvalidFormat(format!("Map file not found: {}", map_name)))
    }
}
