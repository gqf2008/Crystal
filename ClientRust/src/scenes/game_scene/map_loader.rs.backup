// Map file loader - loads .map files from disk
// Mirrors Client/MirScenes/GameScene.cs map loading logic

use std::fs::File;
use std::io::{self, Read, BufReader};
use std::path::Path;
use byteorder::{LittleEndian, ReadBytesExt};

use super::map_control::{MapControl, CellInfo, Door};

/// Map file format constants
const MAP_VERSION: u8 = 1;

/// Error type for map loading
#[derive(Debug)]
pub enum MapLoadError {
    IoError(io::Error),
    InvalidFormat(String),
    UnsupportedVersion(u8),
}

impl From<io::Error> for MapLoadError {
    fn from(err: io::Error) -> Self {
        MapLoadError::IoError(err)
    }
}

impl std::fmt::Display for MapLoadError {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        match self {
            MapLoadError::IoError(e) => write!(f, "IO Error: {}", e),
            MapLoadError::InvalidFormat(msg) => write!(f, "Invalid map format: {}", msg),
            MapLoadError::UnsupportedVersion(v) => write!(f, "Unsupported map version: {}", v),
        }
    }
}

impl std::error::Error for MapLoadError {}

/// Load map from .map file
/// 
/// Map file format:
/// - Header: version (u8), width (i16), height (i16)
/// - Cells: for each cell: flags (u8), file_index (i16), tile_index (u16)
/// - Doors: door_count (i32), [door_data...]
pub fn load_map<P: AsRef<Path>>(path: P) -> Result<MapControl, MapLoadError> {
    let path = path.as_ref();
    tracing::info!("📂 Loading map file: {}", path.display());
    
    let file = File::open(path)?;
    let mut reader = BufReader::new(file);
    
    // Read header
    let version = reader.read_u8()?;
    if version != MAP_VERSION {
        return Err(MapLoadError::UnsupportedVersion(version));
    }
    
    let width = reader.read_i16::<LittleEndian>()? as i32;
    let height = reader.read_i16::<LittleEndian>()? as i32;
    
    tracing::info!("📐 Map dimensions: {}x{}", width, height);
    
    // Create map control
    let mut map = MapControl::new(width, height);
    
    // Read cells
    let total_cells = (width * height) as usize;
    tracing::debug!("📦 Reading {} cells...", total_cells);
    
    for y in 0..height {
        for x in 0..width {
            let flags = reader.read_u8()?;
            let file_index = reader.read_i16::<LittleEndian>()? as i32;
            let tile_index = reader.read_u16::<LittleEndian>()?;
            
            if let Some(cell) = map.get_cell_mut(x, y) {
                // Parse flags
                // Bit 0: Walkable
                // Bit 1: Fishable
                // Bit 2: Has door
                // Bit 3-7: Reserved
                cell.walkable = (flags & 0x01) != 0;
                cell.fishable = (flags & 0x02) != 0;
                cell.file_index = file_index;
                cell.frame_index = tile_index;
                
                // Door will be linked later
                cell.door_index = None;
            }
        }
    }
    
    // Read doors
    let door_count = reader.read_i32::<LittleEndian>()?;
    tracing::debug!("🚪 Reading {} doors...", door_count);
    
    for door_idx in 0..door_count as usize {
        let x = reader.read_i16::<LittleEndian>()? as i32;
        let y = reader.read_i16::<LittleEndian>()? as i32;
        let image_index = reader.read_i32::<LittleEndian>()?;
        let opened = reader.read_u8()? != 0;
        let offset = reader.read_u8()?;
        
        let door = Door {
            index: door_idx,
            location: (x, y),
            opened,
            image_index,
        };
        
        map.doors.push(door);
        
        // Link cell to door
        if let Some(cell) = map.get_cell_mut(x, y) {
            cell.door_index = Some(door_idx);
            cell.door_offset = offset;
        }
    }
    
    // Set filename and title from path
    if let Some(filename) = path.file_name() {
        map.filename = filename.to_string_lossy().to_string();
    }
    
    if let Some(stem) = path.file_stem() {
        map.title = stem.to_string_lossy().to_string();
    }
    
    tracing::info!("✅ Map loaded successfully: {} ({}x{})", map.filename, width, height);
    Ok(map)
}

/// Find map file in standard locations
pub fn find_map_file(map_name: &str) -> Option<std::path::PathBuf> {
    // Try different locations
    let search_paths = [
        format!("Data/Map/{}.map", map_name),
        format!("../Data/Map/{}.map", map_name),
        format!("../../Data/Map/{}.map", map_name),
        format!("../../../Build/Client/Data/Map/{}.map", map_name),
    ];
    
    for path_str in &search_paths {
        let path = Path::new(path_str);
        if path.exists() {
            tracing::info!("✅ Found map file: {}", path.display());
            return Some(path.to_path_buf());
        }
    }
    
    tracing::warn!("⚠️ Map file not found: {}", map_name);
    None
}

/// Load map by name (searches standard locations)
pub fn load_map_by_name(map_name: &str) -> Result<MapControl, MapLoadError> {
    if let Some(path) = find_map_file(map_name) {
        load_map(path)
    } else {
        Err(MapLoadError::InvalidFormat(format!("Map file not found: {}", map_name)))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_map_load_error_display() {
        let err = MapLoadError::InvalidFormat("test error".to_string());
        assert_eq!(format!("{}", err), "Invalid map format: test error");
        
        let err = MapLoadError::UnsupportedVersion(99);
        assert_eq!(format!("{}", err), "Unsupported map version: 99");
    }
}
