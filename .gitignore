# 游戏数据（本地保留，不入库）：仓库根 Data/、Map/
/Data
/Map
/Server.MirForms/Envir
/ServerRust/Daneo1989
/SharedRust/target
/ServerRust/target
# 根目录误跑 cargo 产生的构建产物（workspace 外直接构建落在这里）
/target/
# /ServerRust/tests 不再整体忽略：集成测试（gate_hardening/no_blocking_send_to_client 等上线门禁）须入库


# 开发调试产物（截图/辅助脚本）
/tools/*
# 例外：上线准入的实机交互验证脚本（40 窗点击巡回 + NPC/hero/manage 验证）要点纳入管理
!tools/acceptance/
/tools/acceptance/*
!tools/acceptance/ui_interact_sweep.ps1
# 巡回覆盖清单：脚本与 Client-Bevy 的 lib 测试共用（漏登记要被 cargo test --lib 拦下）
!tools/acceptance/interact_sweep_manifest.json
!tools/acceptance/UI_VERIFICATION_REPORT.md
!tools/acceptance/ui_verification_report.html
!tools/acceptance/ui_acceptance_2961.html
# 五闭环（买卖/战斗/任务/邮件仓库/跨图·复活）玩家验收夹具：判据全部取状态而非像素，
# 与上面 ui_interact_sweep.ps1 同等级纳入管理（夹具错会给出假绿/假红，实测污染过覆盖数值）
!tools/acceptance/rpc.ps1
!tools/acceptance/l5d_npc_link.ps1
!tools/acceptance/l5e_storage_roundtrip.ps1
# ⑤ 邮件半段：A 发 → B 到邮局取包裹 → B 收取附件（判据取状态；DB 延迟落盘只作参考）
!tools/acceptance/l5f_mail_roundtrip.ps1
!tools/acceptance/dbq.py
# ④ 任务交付夹具：交付点从 NPC 脚本 [QUESTS] 段推导，判据取日志状态翻转 + 奖励 delta
!tools/acceptance/l5g_quest_finish.ps1
# ③ 买卖夹具：开购买页 → 买一件 → 金币 delta + 商品到手
!tools/acceptance/l5h_buy_item.ps1
# ② 跨图/复活夹具：两层传送菜单真换图；死亡→回城复活（含新发现的"没回绑定点地图"记录）
!tools/acceptance/l5i_crossmap.ps1
!tools/acceptance/l5j_revive.ps1
# 窗口生命周期夹具：最小化窗口不得退进程（离线 ~25s；自带阳性对照 `-NoHandler` 必红）
!tools/acceptance/l5t_minimize_survives.ps1
# 法术特效实机夹具（owner「魔法效果完全不对」的可复验判据：spell_fx_probe 真值断言）
!tools/acceptance/l5v_spell_fx.ps1
# 实机资源跨进程锁（客户端 + e2e 账号 + 本地服务端一次只能一组）+ #2961 可复验批次夹具
!tools/acceptance/e2e_lock.ps1
# 锁的自证门禁与批量接入器：门禁脚本进验收门槛的一部分，接入器是「新增夹具别漏接入」的机械保障。
# 注意本目录是「白名单」式管理（`/tools/acceptance/*` + 逐条 `!`）：新夹具/新脚本**必须**在这里加 `!` 一行，
# 否则 `git add` 会被静默忽略（只提示 "paths are ignored"），而门禁 T9.1 又会因文件不在仓库里而看不到它。
!tools/acceptance/e2e_lock_selftest.ps1
!tools/acceptance/enroll_e2e_lock.ps1
!tools/acceptance/l5u_ui_batch_2961.ps1
# #3120 ③：邮件列表分页键/页号夹具——判据取只读 RPC `mail_probe` 的分页状态真值，
# 点击走真实 picking（`click` 注入），数据用 mock `--mail-many` 预置 21 封（不起服务端、不写 DB）
!tools/acceptance/l5x_mail_pager.ps1
# 运营就绪最小集（部署/回滚/压测/可观测性）：与 acceptance 夹具同等级纳入管理，
# 判据脚本是上线门槛的一部分，不能只躺在某台机器上（ops/out 仍是本地产物，不纳入）
!tools/ops/
/tools/ops/*
!tools/ops/README.md
!tools/ops/bot.py
!tools/ops/db_snapshot.py
!tools/ops/deploy_smoke.ps1
!tools/ops/rollback_drill.ps1
!tools/ops/load_baseline.ps1
!tools/ops/health_report.ps1
!tools/ops/seed_load_accounts.py
!tools/ops/fix_seed_account_links.py
!tools/ops/capacity_ramp.ps1
!tools/ops/CAPACITY.md
!tools/ops/EXTERNAL_OPS_HANDOFF.md
!tools/ops/fault_injection.ps1
!tools/ops/alert_probe.ps1
!tools/ops/latency_proxy.py
!tools/ops/memory_cycle.ps1
!tools/ops/fresh_mirdb_deploy.ps1
!tools/ops/mirdb_counts.py
!tools/ops/migration_drill.ps1
!tools/ops/db_exec.py
!tools/ops/csharp_pbkdf2_hash.py

# 客户端运行时本地设置（游戏自写自读，不入库；两个客户端都按进程 CWD 相对路径写，
# 故用不带前导斜杠的模式覆盖任意启动目录）
Mir2Config.ini
KeyBinds.ini
QuestTracking.ini
Mir2Test.ini
